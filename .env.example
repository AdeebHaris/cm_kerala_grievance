# ==============================================================================
# CM Kerala Public Grievance Redressal Portal — Root Environment Example
# ==============================================================================
# Copy backend variables into `backend/.env` and frontend variables into
# `frontend/.env`. Replace all placeholder values before running locally.
# NEVER commit actual credentials, database passwords, or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (place in backend/.env)
# ------------------------------------------------------------------------------

# Async PostgreSQL connection string (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/cm_kerala

# JWT signing secret (use a long random string in production)
SECRET_KEY=replace-with-a-strong-random-jwt-secret

# JWT signing algorithm and token validity window
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Groq API Key for AI Grievance Triage (model: openai/gpt-oss-120b)
# Leave empty to exercise the local fallback classifier
GROQ_API_KEY=your-groq-api-key-here

# Allowed frontend origin for CORS and backend HTTP server port
FRONTEND_URL=http://localhost:5173
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (place in frontend/.env)
# ------------------------------------------------------------------------------

# Base URL of the FastAPI backend API
VITE_API_URL=http://localhost:8000
